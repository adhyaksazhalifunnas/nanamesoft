# Copy to .env.local for local development. Never commit the real file.
#
# The site builds and runs with every one of these unset. Each is a feature
# that degrades gracefully rather than a requirement that fails loudly —
# see the notes on each.

# ── GitHub sync (build time only, never runtime) ─────────────────────────────
# A fine-grained personal access token with READ-ONLY access to public
# repository metadata, and nothing else (PRD §5.7). GitHub's GraphQL API has
# no anonymous tier, so `pnpm sync:github` cannot fetch anything without this.
# Unset: sync warns, keeps the committed cache, and exits 0. The build still
# succeeds; the repository evidence blocks just show older data.
# Rotate every 90 days. In CI this lives in Actions secrets, never in a file.
GH_SYNC_TOKEN=

# ── Contact form delivery ────────────────────────────────────────────────────
# Unset: submissions are validated and logged to the server console but no
# email is sent. Useful locally; obviously not what you want in production.
RESEND_API_KEY=
# The verified sender address on your Resend domain.
CONTACT_FROM_EMAIL=

# ── Spam protection ──────────────────────────────────────────────────────────
# Cloudflare Turnstile. Unset: verification is skipped and the other three
# layers (honeypot, minimum fill time, per-IP rate limit) still apply. A
# portfolio that refuses all contact because an env var is missing is a worse
# failure than one without a CAPTCHA.
TURNSTILE_SECRET_KEY=
NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# ── Optional: immediate rebuild webhook (P2, §7.3) ───────────────────────────
GH_WEBHOOK_SECRET=
