{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":dependencyDashboard"],
  "schedule": ["before 6am on monday"],
  "prConcurrentLimit": 3,
  "packageRules": [
    {
      "description": "Group the framework so React and Next never land apart.",
      "matchPackageNames": [
        "next",
        "react",
        "react-dom",
        "@types/react",
        "@types/react-dom",
        "eslint-config-next"
      ],
      "groupName": "next + react"
    },
    {
      "description": "A Next or React bump moves the JS floor, so check:bundle's FLOOR_BUDGET_KB may need updating with it.",
      "matchPackageNames": ["next", "react"],
      "addLabels": ["check-bundle-floor"]
    },
    {
      "description": "Dev tooling can land together and unattended-ish.",
      "matchDepTypes": ["devDependencies"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "dev tooling"
    }
  ]
}
