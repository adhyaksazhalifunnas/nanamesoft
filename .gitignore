# Dependencies
node_modules/
.pnp
.pnp.*

# Next.js
/.next/
/out/
next-env.d.ts

# Testing
/coverage
/playwright-report/
/test-results/
/blob-report/
/playwright/.cache/

# Environment — never commit secrets (PRD §5.7)
.env
.env*.local

# Deployment and tool caches
.vercel
*.tsbuildinfo
.eslintcache
.lighthouseci/

# OS and editors
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json

# NOTE: data/github-cache.json is deliberately NOT ignored. It is committed on
# purpose so `pnpm build` succeeds with no network access (AC-16.1) and so a
# GitHub outage can never break a deploy.
